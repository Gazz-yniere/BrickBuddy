PORT=8000
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
APP_PASSWORD=replace-with-your-own-password-at-least-12-characters
SESSION_COOKIE_SECURE=false
# Facultatif : clé à créer sur https://rebrickable.com/api/, ou à enregistrer
# sur la page « Paramètres » de l'application.
REBRICKABLE_API_KEY=
# Facultatif : affichage des prix dans l'inventaire et sur l'accueil. L'API
# Rebrickable ne fournit aucun prix ; la source est l'API BrickOwl (clé gratuite :
# https://www.brickowl.com/seller/api), à enregistrer ici ou sur la page « Paramètres ».
# Les prix sont relevés une fois par jour, en livres, puis convertis en euros.
SHOW_PRICES=false
BRICKOWL_API_KEY=
# Repli du taux livres → euros : le taux est relevé chaque jour chez un service
# public de change, et cette valeur sert tant qu'aucun relevé n'a réussi.
PRICE_GBP_EUR_RATE=1.18
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_REPOSITORY=brickbuddy
IMAGE_TAG=latest
# Facultatif : chemin de la base SQLite (par défaut data/legolist.db). Le cache
# d'images et le dossier des notices se placent à côté de cette base, ainsi que la
# sauvegarde bdd.bak écrite avant une mise à jour.
# DATABASE_PATH=data/legolist.db
